# OpenHamClock Configuration
#
# This file is automatically copied to .env on first run.
# Edit .env with your station info — it won't be overwritten by updates.
#
# After editing, restart the server: npm start
#
# -------------------------------------------
# DEV PORTS (important)
# -------------------------------------------
# In this repo's default dev setup:
#   - Frontend (Vite dev server): http://localhost:3000
#   - Backend API (Node/Express): http://localhost:3001
#
# The Vite dev server proxies /api to the backend on :3001.
# If you run the backend on :3000, it will conflict with Vite.
# -------------------------------------------

# ===========================================
# REQUIRED — Your Station Information
# ===========================================

# Your amateur radio callsign
CALLSIGN=N0CALL

# Your Maidenhead grid locator (4 or 6 character)
LOCATOR=FN31

# Optional station coordinates (calculated from LOCATOR if not set)
# LATITUDE=40.7128
# LONGITUDE=-74.0060

# ===========================================
# SERVER SETTINGS (Backend API)
# ===========================================

# Backend API server port
# Dev default: 3001 (see DEV PORTS note above)
PORT=3001

# Address shown in the startup banner ("Server running at http://HOST:PORT").
HOST=localhost

# Interface the server listens on (the HTTP server and the HTTPS_PORT listener).
# Default (unset) = every interface, so phones and tablets on your LAN can open
# the dashboard. Set BIND_HOST=127.0.0.1 to keep it on this computer only.
# In Docker leave it unset and restrict access with the ports: mapping instead.
# BIND_HOST=127.0.0.1

# Optional HTTPS listener for LAN access (in addition to PORT). Browsers only
# allow microphone/sound-card capture (the Decoder panel) on HTTPS or
# localhost, so a dashboard opened as http://<pi-ip>:3000 from another
# computer cannot listen. With HTTPS_PORT set, the same app also answers on
# https://<pi-ip>:<HTTPS_PORT> using a self-signed certificate generated once
# with `openssl` (accept the browser warning once per device). Use your own
# certificate with HTTPS_CERT/HTTPS_KEY. Delete HTTPS_CERT_DIR to regenerate
# after the machine's IP or name changes.
# HTTPS_PORT=3443
# HTTPS_CERT=/path/to/fullchain.pem
# HTTPS_KEY=/path/to/privkey.pem
# HTTPS_CERT_DIR=./data/lan-https

# Cloud Relay KiwiSDR audio (Decoder panel): maximum concurrent relayed
# audio sessions on this server (~12 kB/s each while someone listens).
# RELAY_AUDIO_MAX_STREAMS=10

# ===========================================
# SECURITY
# ===========================================

# API key for write operations (POST /api/update, /api/settings, /api/n3fjp/qso, etc.)
# If not set, write endpoints are open (fine for local/home network installs).
# REQUIRED for cloud/public deployments to prevent unauthorized access.
# API_WRITE_KEY=your-secret-key-here

# API key for the Prometheus /metrics endpoint.
# When set, requires a matching ?key= query param or Authorization: Bearer <key> header.
# Leave unset for public metrics (default, fine for local/private installs).
# Useful for Railway deployments behind private networking — set this key so only
# internal scrapers (e.g. Prometheus in the same Railway project) can access metrics.
# NOTE: Prefer Authorization: Bearer over ?key= — the latter leaks into access logs
#        when the server is behind a proxy that logs query strings (nginx, Cloudflare, etc.).
# METRICS_AUTH_KEY=your-secret-key-here

# CORS allowed origins (comma-separated)
# By default, only localhost and openhamclock.com/app origins are allowed.
# Add your custom domain if you host OHC behind your own URL.
# CORS_ORIGINS=https://yourdomain.com

# Trust proxy headers (X-Forwarded-For) for rate limiting IP detection.
# Auto-detected: enabled on Railway, disabled on Pi/local installs.
# Set to 'true' if behind nginx/Caddy/etc., 'false' to force off.
# TRUST_PROXY=true

# Take the client IP from Cloudflare's CF-Connecting-IP header (for rate
# limiting and per-IP caps). WARNING: only enable this when the server is
# reachable ONLY through Cloudflare (origin firewalled to Cloudflare's IP
# ranges, or a Cloudflare Tunnel). If anyone can reach it directly they can
# forge the header and dodge every per-IP limit. Off by default.
# TRUST_CLOUDFLARE=true

# ===========================================
# AUTO UPDATE (GIT)
# ===========================================

# Enable automatic updates (requires git installation and repo clone)
AUTO_UPDATE_ENABLED=false

# Check interval in minutes
AUTO_UPDATE_INTERVAL_MINUTES=60

# Run a check shortly after startup (true/false)
AUTO_UPDATE_ON_START=false

# Exit after update so a supervisor (systemd/pm2) can restart (true/false)
AUTO_UPDATE_EXIT_AFTER=true

# ===========================================
# SETTINGS SYNC (Self-Hosted / Pi)
# ===========================================

# When enabled, all UI settings (layout, panels, map layers, filters, theme, etc.)
# are saved on the server. Any device that connects to your OHC instance will
# automatically load your saved configuration — no need to set up each browser.
#
# Disabled by default. Enable for single-operator self-hosted/Pi deployments.
# Do NOT enable on multi-user hosted deployments (e.g. openhamclock.com).
SETTINGS_SYNC=false

# Optional: custom path for settings file (default: ./data/settings.json)
# SETTINGS_FILE=/path/to/settings.json

# ===========================================
# DISPLAY PREFERENCES
# ===========================================

# Units: 'imperial' or 'metric'
# Deprecated
UNITS=imperial

# Seperated Units ('imperial' or 'metric')
# DISTUNITS - Distance units
DISTUNITS=imperial
# TEMPUNITS - Temperature Units
TEMPUNITS=imperial
# PRESSUNITS - Pressure Units
PRESSUNITS=imperial

# Time format: '12' or '24' hour
TIME_FORMAT=12

# Theme: 'dark', 'light', 'legacy', or 'retro'
THEME=dark

# Layout: 'modern' or 'classic'
LAYOUT=modern

# SERVERLOCAL - if set to true overrides all useLocalInstall() tests in the client; otherwise
# falls back on the local tests.
# SERVERLOCAL=false

# Timezone: IANA timezone identifier
# Set this if your local time shows incorrectly (e.g. same as UTC).
# Common with privacy browsers that spoof timezone.
# Examples: America/New_York, America/Regina, Europe/London, Asia/Tokyo
# Leave blank/commented to use browser default.
# TZ=America/New_York

# ===========================================
# OPTIONAL — External Services
# ===========================================

# ITURHFProp service URL (for advanced propagation predictions)
# Override only if self-hosting your own ITURHFProp service.
# ITURHFPROP_URL=https://proppy-production.up.railway.app

# DX Spider Proxy URL (for DX cluster spots)
# DXSPIDER_PROXY_URL=https://your-dxspider-proxy.com

# DX Cluster source: auto | proxy | hamqth | dxspider
# auto = tries proxy first, then HamQTH, then direct telnet
# proxy = use DX Spider Proxy (set DXSPIDER_PROXY_URL above)
# hamqth = HamQTH CSV feed (HTTP, works everywhere)
# dxspider = direct telnet to DX Spider nodes (works locally/Pi)
# DX_CLUSTER_SOURCE=auto

# Optional custom telnet defaults (used when source=custom and frontend values are empty)
# DX_CLUSTER_HOST=dx.someserver.com
# DX_CLUSTER_PORT=7300

# Optional fixed spotter coordinates for local skimmer setups.
# When both are set, ALL spotter origins on the map use these coordinates.
# Only use with source=custom (local skimmer) — using with proxy/auto would
# pin every spotter worldwide to one location.
# DX_CLUSTER_SPOTTER_LAT=50.70573
# DX_CLUSTER_SPOTTER_LON=4.39205

# OpenWeatherMap API key (optional — only needed for the Cloud Layer map overlay)
# Weather data uses Open-Meteo directly from each user's browser — no key needed.
# OPENWEATHER_API_KEY=your_api_key_here
# VITE_OPENWEATHER_API_KEY=your_api_key_here

# QRZ.com XML API credentials (optional — improves callsign location accuracy)
# QRZ_USERNAME=your_callsign
# QRZ_PASSWORD=your_qrz_password

# HamQTH XML Search API credentials (optional — provides name, grid, coords)
# Your HamQTH registered callsign and password
# https://www.hamqth.com/
# HAMQTH_USERNAME=your_hamqth_callsign
# HAMQTH_PASSWORD=your_hamqth_password

# Satellite data sources (effect server only)
# CelesTrak.org data source is enabled by default, no username or password is needed.
# CelesTrak can be disabled by setting CELESTRAK_ENABLED=false, but it is recommended to keep it enabled as a backup source.
CELESTRAK_ENABLED=true
# AMSAT TLE data source is enabled by default, no username or password is needed.
# AMSAT TLE can be disabled by setting AMSAT_TLE_ENABLED=false, but it is recommended to keep it enabled as a backup source.
AMSAT_TLE_ENABLED=true
# SATNOGS TLE data source is enabled by default, no username or password is needed.
# SATNOGS TLE can be disabled by setting SATNOGS_TLE_ENABLED=false, but it is recommended to keep it enabled as a backup source.
SATNOGS_TLE_ENABLED=true
# Space-Track.org is disabled by default, but can be enabled by providing a valid username and password.
# To enable both username and password fields must be active.
# When enabled Space-Track.org becomes primary data source for satellite data with CelesTrak as backup.
#SPACE_TRACK_USERNAME=your_username
#SPACE_TRACK_PASSWORD=your_password

# ===========================================
# FEATURE TOGGLES
# ===========================================

SHOW_POTA=true
SHOW_SATELLITES=true
SHOW_DX_PATHS=true
SHOW_DX_WEATHER=true

# Show analog clock in classic layout (true/false)
# The analog clock is always available in the dockable layout
CLASSIC_ANALOG_CLOCK=false

# ===========================================
# WSJT-X / JTDX UDP INTEGRATION
# ===========================================

WSJTX_ENABLED=true
WSJTX_UDP_PORT=2237

# Multicast address group for WSJTX. Leave commented if not being used
# WSJTX_MULTICAST_ADDRESS=224.0.0.1

# Relay key for remote WSJT-X relay agent (cloud deployments)
# WSJTX_RELAY_KEY=your-secret-relay-key-here

# ===========================================
# APRS-IS INTEGRATION
# ===========================================
# Enable real-time APRS position tracking from the APRS-IS network.
# Read-only connection (no transmit). Great for EmComm, public service, and tracking.
#
# APRS_ENABLED is the server-wide master switch. With it on, the server keeps
# ONE APRS-IS connection for every viewer. Each viewer's APRS panel (gear
# button) asks for the area around its own station location (radius 50-1000
# km, or "Local RF only"); the connection's filter is the union of those
# areas, changed live (at most every 30 s), and each viewer gets only the
# stations in its own circle. Areas expire 10 min after a viewer stops
# polling; with no areas and no APRS_FILTER the connection closes after
# 15 min idle and reopens when a viewer asks. This works the same on a
# self-hosted clock and on a shared/hosted server - no APRS_FILTER needed.
# The login uses APRS_LOGIN, else CALLSIGN from this file (read-only,
# passcode -1). It must be a real amateur callsign, optionally with an
# SSID (e.g. W1ABC-10): with N0CALL or no callsign the server never logs
# in and internet APRS stays off.

# APRS_ENABLED=true
# APRS_LOGIN=W1ABC-10
# APRS_HOST=rotate.aprs2.net
# APRS_PORT=14580

# Optional fixed filter, always added to the viewers' areas (and the server
# connects at startup when it is set):
#   r/LAT/LON/RANGE  — Stations within RANGE km of LAT/LON
#   b/CALL1/CALL2    — Only specific callsigns
#   p/PREFIX          — Prefix filter, e.g. p/W/K/N for US calls
# Example: 500km radius around your QTH:
# APRS_FILTER=r/40.12/-74.82/500

# How long to keep stations in the cache (minutes)
# APRS_MAX_AGE_MINUTES=60

# Most stations kept in memory across all viewers' areas (oldest internet
# stations are dropped first; RF stations from your TNC are kept)
# APRS_MAX_STATIONS=5000

# ===========================================
# DX CLUSTER SETTINGS
# ===========================================

# DX_CLUSTER_CALLSIGN=N0CALL-56
SPOT_RETENTION_MINUTES=30

# ===========================================
# CONTEST LOGGER UDP (N1MM / DXLog)
# ===========================================

N1MM_UDP_ENABLED=false
N1MM_UDP_PORT=12060
N1MM_MAX_QSOS=200
N1MM_QSO_MAX_AGE_MINUTES=360

# ===========================================
# WAVELOG EVENT SYNC (optional)
# ===========================================
# Enables immediate Wavelog pull sync when a QSO is logged.
# Wavelog remains the source of truth; MQTT is only the event trigger.
# Leave these unset to use manual Wavelog pull without MQTT events.
#
# WAVELOG_MQTT_URL=mqtt://192.168.1.100:1883
# WAVELOG_MQTT_USERNAME=wavelog
# WAVELOG_MQTT_PASSWORD=your_mqtt_password
# WAVELOG_MQTT_TOPIC=wavelog/qso/logged/1

# ===========================================
# AMBIENT WEATHER (AmbientWeather.net)
# ===========================================

# These are read by the Vite client (must start with VITE_)
# Put real keys in .env.local (recommended) so you don't commit secrets.

VITE_AMBIENT_APPLICATION_KEY=your_application_key_here
VITE_AMBIENT_API_KEY=your_api_key_here

# Optional: MAC address of the station device to use (if you have multiple)
# VITE_AMBIENT_DEVICE_MAC=48:E7:29:69:96:10

# Optional: polling interval in seconds (minimum 15)
# VITE_AMBIENT_POLL_SECONDS=30

# ===========================================
# ROTATOR CONTROL
# ===========================================
# Uncomment and configure ONLY if you have a PSTRotator-compatible rotator.
# The server only speaks UDP to PSTRotator — enable UDP in PSTRotator's own
# Setup → Communication and match the port below. The default value is 'none';
# 'pstrotator_udp' is currently the only other supported value.
# ROTATOR_PROVIDER=pstrotator_udp
# PSTROTATOR_HOST=192.168.1.43
# PSTROTATOR_UDP_PORT=12000
# ROTATOR_STALE_MS=5000

# Your app will use the proxy path:
# VITE_PSTROTATOR_BASE_URL=/pstrotator

# Optional: HTTP endpoint for PstRotatorAz web interface (for proxy)
# Set this to the machine running PstRotatorAz (default shown below)
# VITE_PSTROTATOR_TARGET=http://192.168.1.43:50004

# ===========================================
# N3FJP QSO RETENTION
# ===========================================

# How long the server keeps logged QSOs in memory (minutes)
# 1440 = 24 hours
N3FJP_QSO_RETENTION_MINUTES=1440

# ===========================================
# WINLINK GATEWAY DISCOVERY (optional)
# ===========================================
#
# Server-side proxy for the Winlink /gateway/proximity and /channel/list APIs,
# used by the Winlink map layer and panel (issue #297). Request a key from
# the Winlink team (winlink.org). Without this, /api/winlink/gateways returns
# 503 and the browser falls back to the local rig-bridge plugin — so you only
# need this on the public/cloud deployment, not on rig-bridge-equipped local
# installs.
#
# WINLINK_API_KEY=your_key_here

# ─── DX-WORLD NEWS RELAY (hosted deployments only) ───────────────────────────
# DX-World's Cloudflare blocks datacenter egress IPs, so hosted instances
# fetch the feed through the dx-relay Cloudflare Worker (see dx-relay/README).
# Self-hosted installs on home connections can leave these unset.
# DXWORLD_PROXY_URL=https://dx-relay.example.workers.dev/dxworld-feed
# DXWORLD_PROXY_KEY=matching_RELAY_KEY_secret

# ===========================================
# WEB PUSH NOTIFICATIONS (optional)
# ===========================================
#
# True closed-browser push notifications (v1: severe space weather alerts,
# NOAA scale >= 2). Without these keys the feature is dormant: /api/push/*
# returns 503 and the Settings toggle shows it as unavailable — nothing else
# changes. Generate a key pair once with:
#
#   npx web-push generate-vapid-keys
#
# VAPID_SUBJECT is a contact URI (mailto: or https:) push services can use to
# reach you; replace the placeholder with your own address.
#
# VAPID_PUBLIC_KEY=BP...your_generated_public_key
# VAPID_PRIVATE_KEY=your_generated_private_key
# VAPID_SUBJECT=mailto:admin@example.com
#
# Optional: where subscriptions + push dedupe state persist (defaults to the
# same writable-path waterfall as other data files: /data, ./data, /tmp).
# PUSH_SUBSCRIPTIONS_FILE=/data/push-subscriptions.json
#
# Lightning guard pushes (Settings → Alerts → Lightning guard → Web Push) work
# on any server with the keys above: each browser opts in with its station
# location and radii, and only subscribers within their own radius of a
# reported strike get a push (throttled per subscriber, rate-limited per
# client). Override for a server you alone use: PUSH_LIGHTNING_BROADCAST=true
# sends every lightning report to EVERY subscriber instead, as before.
# PUSH_LIGHTNING_BROADCAST=true

# ===========================================
# MESSAGE OF THE DAY
# ===========================================
#
# A one-line notice shown to every browser as a dismissible top bar (bare
# URLs become links). Change it live without a restart with
#   POST /api/admin/motd {"text":"..."}  (Authorization: Bearer API_WRITE_KEY)
# — an admin-set message overrides this one; empty text clears it.
# MOTD=Scheduled maintenance Saturday 0200z — see https://example.org/status
#
# Where the admin-set message persists (defaults to the /data, ./data, /tmp waterfall)
# MOTD_FILE=/data/motd.json

# ===========================================
# HAMALERT (optional, self-hosted)
# ===========================================
#
# Keep one persistent telnet session to hamalert.org:7300 with your HamAlert
# login and serve the alerts to every browser on this instance at
# /api/hamalert/alerts (HamAlert panel). Leave unset to stay dormant — on a
# shared/hosted server use the Rig Bridge HamAlert plugin instead, which is
# per user. Credentials are never logged or returned by the API.
# HAMALERT_USER=yourhamalertname
# HAMALERT_PASS=yourhamalertpassword

# ===========================================
# DOCKER / HEALTH CHECK
# ===========================================

# Override the health check endpoint (useful behind a reverse proxy)
# HEALTH_ENDPOINT=http://localhost:3000/api/health

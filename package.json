{
  "name": "openhamclock",
  "version": "26.10.5",
  "description": "Amateur Radio Dashboard - A modern web-based HamClock alternative",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npx vite",
    "electron": "electron .",
    "electron-builder": "electron-builder",
    "prebuild": "node scripts/fetch-wasm.js",
    "build": "npx vite build",
    "build:binaries": "node scripts/build-binaries.js",
    "bridge:n3fjp": "node scripts/n3fjp-bridge.js",
    "lang:check": "node scripts/lang-check-json-key-sort.js",
    "lang:sort": "node scripts/lang-json-key-sort.mjs",
    "lightning:sync": "node scripts/lightning-guard-cjs.mjs",
    "preview": "npx vite preview",
    "prestart": "npm run build",
    "server": "node server.js",
    "start": "node server.js",
    "test": "npx vitest",
    "test:ui": "npx vitest --ui",
    "test:run": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "sync:upstream": "bash scripts/sync-upstream.sh",
    "update:aur": "bash scripts/update-aur.sh",
    "build:snap": "bash scripts/build-snap.sh",
    "lint": "eslint .",
    "prepare": "husky || true",
    "vendor:aprs-deviceid": "node scripts/vendor-aprs-deviceid.mjs"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "axios-cookiejar-support": "^6.0.5",
    "compression": "^1.7.4",
    "convert-csv-to-json": "^4.38.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "flexlayout-react": "^0.7.15",
    "geo-tz": "^8.1",
    "helmet": "^8.0.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "mqtt": "^5.15.0",
    "node-fetch": "^2.7.0",
    "papaparse": "^5.5.3",
    "prom-client": "^15.1.3",
    "react-colorful": "^5.6.1",
    "react-i18next": "^16.5.4",
    "rss-parser": "^3.13.0",
    "satellite.js": "^6.0.0",
    "three": "^0.185.1",
    "tough-cookie": "^6.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "electron": "^41.10.7",
    "electron-builder": "^26.8.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.0",
    "jsdom": "^25.0.1",
    "jsonc-parser": "^3.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "3.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --max-warnings=-1 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml,cjs}": "prettier --write"
  },
  "keywords": [
    "amateur-radio",
    "ham-radio",
    "hamclock",
    "dx-cluster",
    "propagation",
    "pota",
    "satellite-tracking",
    "pskreporter"
  ],
  "author": "K0CJH",
  "contributors": [
    {
      "name": "HB3XCO",
      "email": "qsl@hb3xco.ch",
      "url": "https://seventrees.io"
    }
  ],
  "license": "MIT",
  "overrides": {
    "qs": "^6.16.0"
  },
  "pkg": {
    "scripts": [
      "node_modules/geo-tz/dist/find-all.js"
    ],
    "assets": [
      "dist/**/*",
      "public/**/*",
      ".env.example",
      "config.example.json",
      "node_modules/geo-tz/package.json",
      "node_modules/geo-tz/data/timezones.geojson.geo.dat"
    ]
  }
}
